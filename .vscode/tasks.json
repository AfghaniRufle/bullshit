{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configurete",
            "type": "process",
            "command": "cmake",
            "args": [
            "-G",
            "MinGW Makefiles",
            "-B",
            "build",
            "-DCMAKE_BUILD_TYPE=Debug",
            "-DFETCHCONTENT_UPDATES_DISCONNECTED=ON"
            ],
    "problemMatcher": []
        },
        {
            "label": "buildte",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build and runte",
            "type": "process",
            "command": "${workspaceFolder}/build/sandbx.exe",
            "dependsOn": "buildte",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
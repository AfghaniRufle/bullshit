{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug sandbx",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbx.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "buildte",
            "setupCommands": [
                {
                    "description": "Rapikan tampilan gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}